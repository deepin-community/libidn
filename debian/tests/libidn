  return 0;
}
EOF

gcc -o libidntest libidntest.c `pkg-config --cflags --libs libidn`
echo "PASS: gcc"
[ -x libidntest ]
./libidntest
echo "PASS: run"
man -P cat stringprep_check_version
echo "PASS: man"
